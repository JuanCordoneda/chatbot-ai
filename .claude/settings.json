{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd /Users/abc/Desktop/CROW/chatbot-ai && /usr/local/bin/docker compose restart web-service openai-service &>> /tmp/flask-growi.log",
            "statusMessage": "Reiniciando servicios...",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /Users/abc/Desktop/CROW/chatbot-ai && /usr/local/bin/docker compose restart web-service openai-service &>> /tmp/flask-growi.log &",
            "async": true
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(curl -s -o /dev/null -w \"%{http_code} %{redirect_url}\\\\n\" http://localhost:8502/)",
      "Bash(curl -sI http://localhost:8502/login)"
    ]
  }
}
